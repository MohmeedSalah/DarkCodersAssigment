# ========================================================
# OpenClaw Gateway & Ports Configuration
# ========================================================
OPENCLAW_PORT="18789"
ASR_PORT="8000"
OPENCLAW_GATEWAY_URL="http://localhost:18789"
VITE_OPENCLAW_GATEWAY_URL="http://localhost:18789"

# ========================================================
# Upstream LLM Configuration (Google Gemini)
# ========================================================
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_PRIMARY_MODEL="gemini-3.5-flash"
GEMINI_FALLBACK_MODELS="gemini-3.6-flash,gemma-4-31b-it,gemini-3.7-flash"

# ========================================================
# OpenClaw Model & Voice Defaults
# ========================================================
OPENCLAW_DEFAULT_MODEL="openclaw/default"
OPENCLAW_TRANSCRIBE_MODEL="whisper-1"
OPENCLAW_SPEECH_MODEL="tts-1"
OPENCLAW_SPEECH_VOICE="alloy"
